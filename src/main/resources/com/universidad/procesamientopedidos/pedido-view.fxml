<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.universidad.procesamientopedidos.controller.PedidoController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Procesamiento de pedidos"/>

    <ProgressBar fx:id="barraProgreso"
                 progress="0"
                 prefWidth="350"/>

    <Label fx:id="lblContador"
           text="Pedidos completados: 0/30"/>

    <Label fx:id="lblEstado"
           text="Estado: Listo"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnIniciar"
                text="Iniciar"
                onAction="#iniciarProcesamiento"/>

        <Button fx:id="btnCancelar"
                text="Cancelar"
                onAction="#cancelarProcesamiento"
                disable="true"/>
    </HBox>

</VBox>
